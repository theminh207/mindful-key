{
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "includeCoAuthoredBy": false,
  "enabledMcpjsonServers": ["context7", "memory", "sequential-thinking"],
  "permissions": {
    "ask": ["Bash(npm publish:*)", "Bash(docker push:*)"],
    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf .)",
      "Bash(rm -rf /)",
      "Bash(del /s:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -f:*)",
      "Bash(git branch -D:*)",
      "Bash(git stash drop:*)",
      "Bash(git checkout -- .)",
      "Bash(git checkout -- :*)",
      "Bash(git restore .)",
      "Bash(git restore --staged:*)",
      "Edit(**/.git/**)",
      "Edit(.git/**)",
      "Edit(**/.env*)",
      "Edit(.env*)",
      "Edit(**/secrets/**)",
      "Edit(**/credentials*)",
      "Edit(**/generated/**)",
      "Edit(**/obj/**)",
      "Edit(**/bin/**)",
      "Edit(**/dist/**)",
      "Edit(**/node_modules/**)",
      "Read(**/.git/**)",
      "Read(.git/**)",
      "Read(**/.env*)",
      "Read(.env*)",
      "Read(**/secrets/**)",
      "Read(**/credentials*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node .claude/statusline.js",
    "padding": 0
  }
}
